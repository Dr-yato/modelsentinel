{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ModelSentinel",
          "version": "0.2.0",
          "informationUri": "https://modelsentinel.local/docs",
          "rules": [
            {
              "id": "template_match",
              "shortDescription": {
                "text": "template_drift"
              },
              "fullDescription": {
                "text": "Chat template matches the vendored qwen2.5.jinja reference."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "template_match",
          "level": "note",
          "message": {
            "text": "Chat template matches the vendored qwen2.5.jinja reference."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "application/vnd.ollama.image.model/sha256-29d8c98fa6b098e200069bfb88b9508dc3e85586d20cba59f8dda9a808165104:tokenizer.chat_template"
                }
              }
            }
          ],
          "properties": {
            "severity": "info",
            "category": "template_drift",
            "evidence": "",
            "tool": "modelsentinel"
          }
        }
      ],
      "properties": {
        "verdict": "PASS",
        "score": 100.0,
        "limitation": "A PASS verdict means the configured checks found nothing they were built to find. It does not prove the model is clean."
      }
    }
  ]
}